#!/bin/sh

echo "Starting pre-commit checks..."
echo "Checking staged files..."

# Get staged files once for messaging (safe to reuse for display)
FILES=$(git diff --cached --name-only)

# 1. Prevent committing .env files
echo "Check 1: scanning for .env files..."
ENV_FILES=$(echo "$FILES" | grep -E '(^|/)\.env($|\.|/)' || true)

if [ -n "$ENV_FILES" ]; then
  echo "FAILED: .env file(s) detected in staged changes:"
  echo "$ENV_FILES"
  echo ""
  echo "Why this matters:"
  echo "- .env files often contain secrets (API keys, credentials)"
  echo ""
  echo "How to fix:"
  echo "1. Unstage the file(s):"
  echo "   git reset $ENV_FILES"
  echo "2. Add to .gitignore if not already:"
  echo "   echo '.env' >> .gitignore"
  echo ""
  exit 1
else
  echo "Passed: no .env files detected."
fi

# 2. Prevent committing node_modules
echo "Check 2: scanning for node_modules..."
NODE_MODULE_FILES=$(echo "$FILES" | grep "node_modules" || true)

if [ -n "$NODE_MODULE_FILES" ]; then
  echo "FAILED: node_modules detected in staged changes:"
  echo "$NODE_MODULE_FILES"
  echo ""
  echo "Why this matters:"
  echo "- node_modules is large and should not be version controlled"
  echo ""
  echo "How to fix:"
  echo "1. Unstage the file(s):"
  echo "   git reset $NODE_MODULE_FILES"
  echo "2. Ensure node_modules is in .gitignore"
  echo ""
  exit 1
else
  echo "Passed: no node_modules detected."
fi

# 3. Run lint if it exists
echo "Check 3: running lint (if configured)..."
if npm run | grep -q "lint"; then
  npm run lint
  if [ $? -ne 0 ]; then
    echo "FAILED: lint errors detected."
    echo ""
    echo "How to fix:"
    echo "- Run 'npm run lint' locally to see issues"
    echo "- Fix the reported errors before committing"
    echo ""
    exit 1
  else
    echo "Passed: lint successful."
  fi
else
  echo "Skipped: no lint script found."
fi

echo "All pre-commit checks passed. Proceeding with commit."