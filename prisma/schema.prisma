generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// 👤 INTERNAL USER (mapped from OAuth)
//
model User {
  id            String   @id @default(uuid())
  oauthUserId   String   @unique
  email         String?
  role          UserRole @default(PARENT)

  children      Child[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}


enum UserRole {
  PARENT
}

//
// 🧒 CHILD PROFILE
//
model Child {
  id        String @id @default(uuid())

  userId  String
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])

  name      String
  age       Int?

  streak    Streak?
  bookmarks Bookmark[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//
// 🔥 STREAK (1:1 with child)
//
model Streak {
  id        String @id @default(uuid())

  childId   String @unique
  child     Child  @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])

  current   Int @default(0)
  longest   Int @default(0)
  lastRead  DateTime?
}

//
// 🔖 BOOKMARKS (many per child)
//
model Bookmark {
  id        String @id @default(uuid())

  childId   String
  child     Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  surah     Int
  ayah      Int

  @@unique([childId, surah, ayah])
  @@index([childId])

  note      String?
  createdAt DateTime @default(now())
}